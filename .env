
# --- Application Configuration (.env) ---
# Environment variables should never be committed to a public repository.

# The port the Node.js application will listen on.
# In server.js, this typically defaults to 3000 if not specified.
PORT=3001

# MongoDB Connection URI: 
# This string is used by Mongoose to connect to your database instance.
# For production environments, this should be a secure cloud connection string (e.g., MongoDB Atlas).
MONGO_URI=mongodb://localhost:27017/quiz-Api

# JSON Web Token Secret Key: 
# A long, random, and securely generated string used to sign and verify JWTs.
# **CRITICAL**: Keep this secret private. Generate a new strong key for production.
JWT_SECRET=951ab7a3d156a8f378c3b8a6c60604c568449f40a5f50d14a9ec81957d9d1367

# JWT Expiration Time: 
# The duration after which a issued token becomes invalid.
# Can be in seconds (e.g., '60'), minutes ('10m'), hours ('2h'), or days ('7d').
JWT_EXPIRES_IN=7d

# Bcrypt Salt Rounds: 
# The complexity factor used when hashing user passwords. Higher numbers are more secure but slower.
# 10 is a common standard balance of security and performance.
BCRYPT_SALT_ROUNDS=10
