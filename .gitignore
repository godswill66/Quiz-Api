# --- Node.js Dependencies & Runtime ---
# Ignore the node modules directory where local dependencies are stored
node_modules/
# Ignore log files generated by npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Variables (CRITICAL) ---
# IGNORE YOUR .ENV FILE! This contains your database URI and JWT secret.
.env
# Ignore any potential testing configuration files for dotenvx
.env.test

# --- Runtime Files ---
# Ignore files generated by Node.js
*.js.map
*.ts.map
# Ignore coverage reports (if you add unit testing later)
coverage/

# --- Operating System Generated Files ---
# Thumbnails (macOS)
.DS_Store
# Temporary files (Windows)
Thumbs.db

# --- Nodemon monitoring files ---
# Nodemon sometimes creates monitoring files in development
.nodemonignore
